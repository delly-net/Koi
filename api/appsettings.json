{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Koi": {
    "Database": {
      "Path": "koi.db"
    },
    "StaticFiles": {
      "Enabled": true,
      "RootPath": "wwwroot"
    },
    "Auth": {
      "PamService": "login",
      "SessionExpireHours": 8,
      "CookieName": "koi_session",
      "LoginRateLimitPerMinute": 10,
      "AllowedOrigins": []
    },
    "Files": {
      "Enabled": true,
      "AllowedRoots": ["/"],
      "MaxUploadBytes": 104857600,
      "MaxListEntries": 5000,
      "HelperTimeoutSeconds": 120
    },
    "Terminal": {
      "Enabled": true,
      "Shell": "",
      "ShellArguments": ["-l"],
      "MaxSessionsPerUser": 4,
      "MaxSessionsTotal": 16,
      "MaxInputBytes": 65536,
      "DefaultCols": 120,
      "DefaultRows": 32,
      "CloseTimeoutSeconds": 5
    }
  }
}
