{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Koi": {
    "Database": {
      "Path": "koi.db"
    },
    "StaticFiles": {
      "Enabled": true,
      "RootPath": "wwwroot"
    },
    "Auth": {
      "PamService": "login",
      "SessionExpireHours": 8,
      "CookieName": "koi_session",
      "LoginRateLimitPerMinute": 10,
      "AllowedOrigins": []
    }
  }
}
