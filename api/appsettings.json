{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Koi": {
    "Database": {
      "Path": "koi.db"
    },
    "StaticFiles": {
      "Enabled": true,
      "RootPath": "wwwroot"
    },
    "Auth": {
      "PamService": "login",
      "SessionExpireHours": 8,
      "CookieName": "koi_session",
      "LoginRateLimitPerMinute": 10,
      "AllowedOrigins": []
    },
    "SystemMonitor": {
      "Enabled": true
    },
    "Docker": {
      "Enabled": true,
      "DockerPath": "",
      "AllowedGroups": ["docker"],
      "CommandTimeoutSeconds": 60,
      "PullTimeoutSeconds": 600,
      "MaxOutputBytes": 4194304,
      "MaxLogBytes": 2097152,
      "LogTailDefault": 500,
      "LogTailMax": 5000
    }
  }
}
